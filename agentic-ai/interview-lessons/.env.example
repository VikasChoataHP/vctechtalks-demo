# Only needed if your laptop can't run Ollama. Copy to .env, add your key, then:
#   uv run --env-file .env 00_check_setup.py
# Get a free key at https://aistudio.google.com/apikey. Never commit .env.
# Free-tier prompts may be used by Google to improve its products: use demo data only.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=paste-your-key-here
# Pick a current Flash model from https://ai.google.dev/gemini-api/docs/models
CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
